# ── WooCommerce ───────────────────────────────────────────────────────────────
WC_URL=https://yourdomain.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── API Security ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_API_KEY=generate_a_long_random_string_here

# ── Dashboard (NEXTGIC AI OPS CENTER) ─────────────────────────────────────────
JWT_SECRET=generate_with_python_secrets_token_hex_32
CORS_ORIGINS=http://localhost:3000,https://YOUR-SITE.netlify.app
DASHBOARD_ADMIN_EMAIL=admin@nextgic.com
DASHBOARD_ADMIN_PASSWORD=change_me_in_production

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./nextgic_agent.db

# PostgreSQL (Docker / production) — uncomment and fill:
# DATABASE_URL=postgresql+psycopg2://nextgic:changeme@localhost:5432/nextgic_agent
POSTGRES_USER=nextgic
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nextgic_agent

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_BACKEND=sync
# QUEUE_BACKEND=celery
# REDIS_URL=redis://localhost:6379/0

# ── Image Processing ──────────────────────────────────────────────────────────
PSD_TEMPLATE_PATH=./canvas-Igen__1_.psd
PROCESSED_DIR=./processed_images/

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_LEVEL=INFO
